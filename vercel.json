{
  "functions": {
    "api/runtime/execute.js": { "maxDuration": 300 },
    "api/runtime/start.js": { "maxDuration": 30 },
    "api/runtime/status.js": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}